# Dokploy > ilova > Environment. DATABASE_URL qiymatini almashtiring.
# Parolni GitHubga yuklamang. Bu fayl avtomatik yuklanmaydi.
NODE_ENV=production
HOST=0.0.0.0
PORT=8020
DATABASE_URL=postgresql://USERNAME:PASSWORD@INTERNAL_HOST:5432/DATABASE
DATABASE_SCHEMA=nutq
BACKUP_DIRECTORY=/app/data/backups
# Quyidagi ikki sozlama HTTPS domen va bitta reverse proxy uchun.
COOKIE_SECURE=true
TRUST_PROXY=1
