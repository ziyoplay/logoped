# Nusxasini .env nomi bilan saqlang. Haqiqiy parollarni gitga qo‘shmang.
HOST=0.0.0.0
PORT=3001
DATABASE_PATH=data/nutq.sqlite
# PostgreSQL ishlatish uchun URLni kiriting; bo‘sh bo‘lsa SQLite ishlatiladi.
# DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE
DATABASE_SCHEMA=nutq
# Alohida disk/tarmoq papkasi mavjud bo‘lsa yo‘lini kiriting.
# BACKUP_DIRECTORY=E:/Nutq-zaxira
# HTTPS reverse proxy tayyor bo‘lganda:
# COOKIE_SECURE=true
# TRUST_PROXY=1
# Shaxsiy hisob ochilgach yangi hisoblar va demo yaratishni yopish mumkin.
# ALLOW_REGISTRATION=false
# ALLOW_DEMO=false
