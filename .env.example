# Nusxasini .env nomi bilan saqlang. Haqiqiy parollarni gitga qo‘shmang.
HOST=0.0.0.0
PORT=3001
DATABASE_PATH=data/nutq.sqlite
# PostgreSQL ishlatish uchun URLni kiriting; bo‘sh bo‘lsa SQLite ishlatiladi.
# DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE
DATABASE_SCHEMA=nutq
# Alohida disk/tarmoq papkasi mavjud bo‘lsa yo‘lini kiriting.
# BACKUP_DIRECTORY=E:/Nutq-zaxira
# HTTPS reverse proxy tayyor bo‘lganda:
# COOKIE_SECURE=true
# TRUST_PROXY=1
# Shaxsiy hisob ochilgach yangi hisoblar va demo yaratishni yopish mumkin.
# ALLOW_REGISTRATION=false
# ALLOW_DEMO=false

# Telegram tokeni faqat serverda. Hech qachon VITE_ prefiksini ishlatmang.
# TELEGRAM_BOT_TOKEN=
# VIDEO_DIRECTORY=data/videos

# Google Calendar OAuth: faqat serverda; yo‘riqnoma deploy/google-calendar.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/api/google/callback
# GOOGLE_TOKEN_ENCRYPTION_KEY=BASE64_ENCODED_32_RANDOM_BYTES

# Gemini: faqat serverda. VITE_ prefiksini ishlatmang.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
